+    parity_review_command(&h.app, "sheet.place", json!({"x":30,"y":30})).await;
+    parity_review_command(&h.app, "sheet.test_spot", json!({"x_mm":75,"y_mm":30})).await;
+    let copy = cut_copy(&h.app, "gap-copy").await;
+    let id = copy["value"]["copy"]["id"].as_str().unwrap();
+    for _ in 0..3 {
