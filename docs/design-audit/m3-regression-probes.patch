+    #[test]
+    fn parity_review_unfinished_project_can_be_exported_for_save() {
+        let dir = area();
+        std::fs::write(
+            dir.path().join("designs/star.svg"),
+            STAR.replace("width=\"80mm\" height=\"60mm\"", ""),
+        )
+        .unwrap();
+        let mut w = Worker::new(dir.path(), &dir.path().join("lists")).unwrap();
+        assert!(!open(&mut w).design.unwrap().cut_ready);
+        let result = w.answer(WorkerRequest::Export);
+        assert!(
+            matches!(result, WorkerReply::Export { .. }),
+            "saving unfinished work must not require cutting readiness: {result:?}"
+        );
+    }
