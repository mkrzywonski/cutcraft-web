+        .write_to(&mut bytes, image::ImageFormat::Bmp)
+        .unwrap();
+    let mut req = design(
+        "POST",
+        "/api/v1/design/upload?name=authored.BMP",
+        Body::from(bytes.into_inner()),
+        None,
+    );
+    req.headers_mut().insert(
