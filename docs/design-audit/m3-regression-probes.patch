+#[tokio::test]
+async fn parity_review_tuned_copy_can_continue_same_test_turn() {
+    let mut h = harness();
+    open_star(&h.app, None).await;
+    let first = cut_copy(&h.app, "copy-before-test").await;
+    let first_id = first["value"]["copy"]["id"].as_str().unwrap();
+    for _ in 0..3 {
+        h.worker.step();
+    }
+    h.sim.unload();
+    for _ in 0..3 {
+        h.worker.step();
+    }
+    h.sim.load(Media::Mat12x12);
+    for _ in 0..9 {
+        h.worker.step();
+    }
+    let v = lock(&h.app.service.cutters[0].shared).view();
+    let cameo_pi_core::mat::Mat::Fresh(generation) = v.mat else {
+        panic!("not loaded")
+    };
+    let (status, result) = send(
+        &h.app,
+        page(
+            "POST",
+            "/api/v1/cutters/practice/start",
+            json!({"boot":"t", "kind":"test", "turn":null, "job_id":first_id,
+        "revision":1, "generation":generation, "action_epoch":v.action_epoch, "key":"first-test"}),
+        ),
+    )
+    .await;
+    assert_eq!(status, StatusCode::OK, "{result}");
+    h.worker.step();
+    for _ in 0..8 {
+        h.worker.step();
+    }
+    let s = now(&h.app, None).await;
+    let r = post_design(&h.app, "/api/v1/design/command", json!({"id":"sheet.adjust",
+        "params":{"force":23}, "key":"tune-force", "incarnation":s["incarnation"], "revision":s["revision"]}), None).await;
+    assert_eq!(r["answer"], "applied", "{r}");
+    let next = cut_copy(&h.app, "copy-after-tuning").await;
+    let next_id = next["value"]["copy"]["id"].as_str().unwrap();
+    let v = lock(&h.app.service.cutters[0].shared).view();
+    let (status, result) = send(
+        &h.app,
+        page(
+            "POST",
+            "/api/v1/cutters/practice/start",
+            json!({"boot":"t", "kind":"test", "turn":v.turn.unwrap().id, "job_id":next_id,
+        "revision":1, "generation":generation, "action_epoch":v.action_epoch, "key":"second-test"}),
+        ),
+    )
+    .await;
+    assert_eq!(
+        status,
+        StatusCode::OK,
+        "explicitly reviewed force-only replacement should preserve occupied test spots: {result}"
+    );
+}
