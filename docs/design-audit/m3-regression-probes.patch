+    fn parity_command(w: &mut Worker, id: &str, params: Value) -> CommandReply {
+        let s = snapshot(w);
+        w.command(CommandRequest {
+            id: id.into(),
+            params,
+            key: crate::keys::random_hex(8),
+            incarnation: s.incarnation,
+            revision: Some(s.revision),
+        })
