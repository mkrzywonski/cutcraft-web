+    #[test]
+    fn parity_review_material_adjustments_survive_checkpoint_and_new_import() {
+        let dir = area();
+        let lists = dir.path().join("lists");
+        let mut w = Worker::new(dir.path(), &lists).unwrap();
+        open(&mut w);
+        assert!(matches!(
+            parity_command(&mut w, "sheet.adjust", json!({"force":23,"mirror":true})),
