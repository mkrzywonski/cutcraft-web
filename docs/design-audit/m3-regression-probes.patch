+    #[test]
+    fn parity_review_idle_worker_recovery_preserves_undo() {
+        let dir = area();
+        let lists = dir.path().join("lists");
+        let mut w = Worker::new(dir.path(), &lists).unwrap();
+        open(&mut w);
+        let original = w
+            .controller
+            .snapshot()
+            .unwrap()
+            .design
+            .unwrap()
+            .project
+            .sheets[0]
+            .material
+            .force;
+        assert!(matches!(
+            parity_command(&mut w, "sheet.adjust", json!({"force":23})),
+            CommandReply::Applied { .. }
+        ));
+        w.checkpoint().unwrap();
+        drop(w);
+        let mut recovered = Worker::new(dir.path(), &lists).unwrap();
+        let reply = parity_command(&mut recovered, "history.undo", json!({}));
+        assert!(
+            matches!(reply, CommandReply::Applied { .. }),
+            "same session must retain Undo after worker eviction: {reply:?}"
+        );
+        assert_eq!(
+            recovered
+                .controller
+                .snapshot()
+                .unwrap()
+                .design
+                .unwrap()
+                .project
+                .sheets[0]
+                .material
+                .force,
+            original
+        );
+    }
