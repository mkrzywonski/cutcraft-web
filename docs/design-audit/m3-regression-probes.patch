+                .material
+                .force,
+            23
+        );
+        assert!(matches!(
+            open_as(&mut w, "new-import", true),
+            CommandReply::Applied { .. }
+        ));
+        let sheet = w
+            .controller
+            .snapshot()
+            .unwrap()
+            .design
+            .unwrap()
+            .project
+            .sheets[0]
