+    #[test]
+    fn parity_review_authored_reference_fixture_outcomes() {
+        let root =
+            std::env::var_os("CUTCRAFT_PARITY_FIXTURES").expect("set reference fixture root");
+        let root = PathBuf::from(root);
+        let manifest: Value = serde_json::from_slice(
+            &std::fs::read(root.join("docs/design-audit/fixtures.json")).unwrap(),
+        )
+        .unwrap();
+        let mut count = 0;
+        for fixture in manifest["fixtures"].as_array().unwrap() {
+            let expected = &fixture["initial_reference"];
+            if expected.is_null() {
+                continue;
+            }
+            let file = Path::new(fixture["path"].as_str().unwrap());
+            let name = file.file_name().unwrap().to_str().unwrap();
+            let dir = area();
+            std::fs::copy(root.join(file), dir.path().join("designs").join(name)).unwrap();
+            let mut w = Worker::new(dir.path(), &dir.path().join("lists")).unwrap();
+            let s = snapshot(&mut w);
+            let opened = w.open(OpenRequest {
+                request: None,
+                source: OpenSource::Upload {
+                    file: name.into(),
+                    name: name.into(),
+                },
+                key: "fixture-open".into(),
+                incarnation: s.incarnation,
+                revision: s.revision,
+                replace_unsaved: false,
+            });
+            assert!(
+                matches!(opened, CommandReply::Applied { .. }),
+                "{name}: {opened:?}"
+            );
+            // Inspect internally: the public report adapter is the separate failing probe.
+            let report = w
+                .controller
+                .execute(Origin::User, "prepare.report", json!({}), None)
+                .unwrap()
+                .value;
+            let actual = json!({"cut_ready":report["cut_ready"],
+                "pending":report["pending"].as_array().unwrap().iter().map(|q|q["decision"].clone()).collect::<Vec<_>>(),
+                "diagnostics":report["diagnostics"].as_array().unwrap().iter().map(|d|json!({"code":d["code"],"severity":d["severity"]})).collect::<Vec<_>>(),
+                "changes":report["changes"].as_array().unwrap().iter().map(|c|c["code"].clone()).collect::<Vec<_>>()});
+            assert_eq!(&actual, expected, "reference outcome differs for {name}");
+            count += 1;
+        }
+        assert_eq!(count, 21);
+    }
 }
