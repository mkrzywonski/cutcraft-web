+    #[test]
+    fn parity_review_changed_user_invalidates_retained_load() {
+        let mut c = ready_cutter();
+        let mut first = request(&c, Kind::Test, None, "first-person-test");
+        first.actor.user = Some("first-user".into());
+        let (execution, turn) = started(c.start(first));
+        assert!(c.take_pending().is_some());
+        c.finished(&execution, Outcome::Completed { duration_s: 1.0 });
+        let mut next = request(&c, Kind::Main, Some(&turn), "other-person-main");
+        next.actor.user = Some("second-user".into());
+        let result = c.start(next);
+        assert!(
+            result.is_err(),
+            "changing users requires fresh loading under Q2: {result:?}"
+        );
+    }
